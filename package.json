{
  "name": "development-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @workbench/web build && pnpm --filter @workbench/bridge build",
    "start": "pnpm --filter @workbench/bridge start",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test apps/bridge/test/*.test.ts scripts/*.test.js",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tanstack/eslint-plugin-query": "5.108.1",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint-config-preact": "2.0.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15"
  }
}

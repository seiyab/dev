FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
RUN npm install --global pnpm@10.34.9
WORKDIR /opt/workbench
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts/build-git-broker.ts ./scripts/build-git-broker.ts
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm --filter @workbench/git-broker build

FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/node/.git-broker \
    && chown node:node /home/node/.git-broker
WORKDIR /opt/broker
COPY --from=build /opt/workbench/apps/git-broker/dist ./
USER node
CMD ["node", "index.js", "/run/secrets/broker-policy"]

FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ tmux bash zsh git ca-certificates curl ripgrep unzip \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.34.9 @openai/codex@0.171.0 \
    && git config --system core.editor nvim

COPY scripts/install-workbench-tools.sh /tmp/install-workbench-tools.sh
RUN sh /tmp/install-workbench-tools.sh && rm /tmp/install-workbench-tools.sh \
    && nvim --version && lazygit --version && codex --version

WORKDIR /opt/workbench
COPY --chown=node:node package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY --chown=node:node apps ./apps
COPY --chown=node:node packages ./packages
COPY --chown=node:node scripts/build-bridge.ts scripts/build-git-broker.ts ./scripts/
RUN pnpm install --frozen-lockfile && pnpm build \
    && mkdir -p /home/node/workspace /home/node/.workbench /home/node/.box-capability \
    && chown -R node:node /home/node/workspace /home/node/.workbench /home/node/.box-capability \
    && ln -s /home/node/.workbench /home/node/.history \
    && chsh -s /usr/bin/zsh node \
    && chmod 700 /home/node/.box-capability

COPY --chown=node:node .zshrc /home/node/.zshrc
USER node
ARG NVIM_CONFIG_REVISION=7a7e3830290bf2b7805de2d0a9cbfa76bee18327
RUN git clone https://github.com/seiyab/nv.git /home/node/.config/nvim \
    && git -C /home/node/.config/nvim checkout --detach "$NVIM_CONFIG_REVISION"

ENV PATH="/opt/workbench/apps/git-broker/bin:${PATH}" \
    WORKBENCH_HOST=0.0.0.0 \
    WORKBENCH_SHELL=/usr/bin/zsh \
    WORKBENCH_STATE_DIR=/home/node/.workbench \
    WORKBENCH_WORKSPACE_DIR=/home/node/workspace \
    WORKBENCH_WEB_ROOT=/opt/workbench/apps/web/dist
EXPOSE 3000
CMD ["node", "apps/bridge/dist/index.js"]
